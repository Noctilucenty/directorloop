# DirectorLoop configuration. Copy to .env and fill in. Never commit .env.
# Application
DL_MODE=demo                     # demo | production
DL_BIND_HOST=127.0.0.1           # non-loopback requires a token of at least 32 characters
DL_PORT=8787
DL_DATABASE_URL=sqlite:///./data/directorloop.db   # or postgresql+psycopg://user:pass@host/db
DL_DATA_DIR=./data               # private artifact store root (local filesystem backend)
DL_LOCAL_AUTH_TOKEN=             # production requires >=32 random characters; browser exchanges it for an HttpOnly session
DL_MAX_UPLOAD_MB=200
DL_MAX_ITERATIONS=1
DL_JOB_DEADLINE_SECONDS=45       # presentation cutoff for a live improvement job
DL_APPROVED_SPEND_USD=2.00       # recorded approval setting, NOT an enforced dollar cap; runtime enforces call/deadline limits
DL_GPU_CONCURRENCY=1
DL_EXTERNAL_MEDIA_CONSENT=demo_assets_only   # demo_assets_only | all_project_media

# Weights & Biases (Weave traces, W&B Inference, experiment runs for ARIA)
WANDB_API_KEY=
WANDB_ENTITY=leondragon3798-curio   # team entity (ARIA only works in team projects); project directorloop already exists
WANDB_PROJECT=directorloop
DL_WEAVE_ENABLED=true

# Planner / probe provider selection (exact model ids live here, not in code)
DL_PLANNER_PROVIDER=openai       # openai | gemini | wandb_inference | typesafe | rules (deterministic)
DL_PLANNER_MODEL=gpt-5.6-sol     # verified 2026-09-12: json_schema ok, reasoning_effort high
DL_PROBE_PROVIDER=openai         # openai (frames+ASR) | gemini (native video; key was out of credit 2026-09-12) | wandb_inference (frames)
DL_PROBE_MODEL=gpt-5.6-terra     # verified 2026-09-12: 6 frames in 0.9 s
DL_PROBE_FRAMES=8
DL_PROBE_TRIALS=3
DL_ASR_LANGUAGE=en              # en or auto (or another whisper language code); frozen in evaluator identity
DL_WANDB_INFERENCE_PROBE_MODEL=Qwen/Qwen3.8-27B
DL_WANDB_INFERENCE_PLANNER_MODEL=moonshotai/Kimi-K2.6

# Optional quick screening: isolated from the final evaluator above.
# Three sampled prefixes, review required, no automatic edits or promotion.
DL_SCREENING_ENABLED=false
DL_SCREENING_SPEND_LIMIT_USD=2.00
DL_SCREENING_SPEND_BUDGET_ID=screening-app-20260912-v1
DL_SCREENING_MAX_PHYSICAL_ATTEMPTS=30
DL_SCREENING_SPEND_LEDGER_PATH=  # defaults to DL_DATA_DIR/screening-spend.sqlite3
# A budget id has immutable limits. Never rotate it automatically to bypass exhaustion.

# Provider secrets
GEMINI_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
TYPESAFE_API_KEY=                # only after the real event contract is known
TYPESAFE_BASE_URL=               # capability registry keeps this adapter disabled until a smoke test passes
TYPESAFE_MODEL=

# Local GPU generation (Molab / CUDA worker), optional
DL_GENERATION_PROVIDER=none      # none | ltx_local | fal
DL_LTX_CHECKPOINT=Lightricks/LTX-Video-0.9.8-distilled
DL_LIVE_GENERATION_ENABLED=false # set true only after docs/BENCHMARK_RESULTS.md shows it fits the loop budget
